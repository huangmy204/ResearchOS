# App
RESEARCHOS_ENV=development
RESEARCHOS_WORKSPACE_ROOT=workspace
RESEARCHOS_RUNTIME_PROFILE=developer
RESEARCHOS_LOG_LEVEL=INFO
RESEARCHOS_RETRIEVAL_STRATEGY=keyword
# Supported: keyword, bm25, embedding
RESEARCHOS_RETRIEVAL_CHUNK_CHARS=600
RESEARCHOS_RETRIEVAL_CHUNK_OVERLAP_CHARS=0
RESEARCHOS_RETRIEVAL_TOP_K=3
RESEARCHOS_RETRIEVAL_CANDIDATE_LIMIT=6
RESEARCHOS_RETRIEVAL_RERANKER=none
RESEARCHOS_RETRIEVAL_MAX_CHUNKS_PER_SOURCE=0
RESEARCHOS_RETRIEVAL_MIN_EVIDENCE_COUNT=1
RESEARCHOS_WORKFLOW_ENGINE=sequential

# API
RESEARCHOS_API_HOST=0.0.0.0
RESEARCHOS_API_PORT=8000
RESEARCHOS_CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional infrastructure, not required for the first local MVP.
RESEARCHOS_POSTGRES_URL=
RESEARCHOS_REDIS_URL=
RESEARCHOS_VECTOR_DB_URL=

# Models, intentionally blank for the deterministic MVP workflow.
RESEARCHOS_LLM_CLIENT=mock
RESEARCHOS_LLM_API_KEY=
RESEARCHOS_LLM_TIMEOUT_SEC=30

BASIC_MODEL=
BASIC_BASE_URL=
REASONING_MODEL=
REASONING_BASE_URL=
WRITER_MODEL=
WRITER_BASE_URL=
VERIFIER_MODEL=
VERIFIER_BASE_URL=

# Evaluation
RESEARCHOS_ENABLE_EVAL=true
RESEARCHOS_EVAL_DATASET_DIR=evals/datasets
